{
  "protocol_id": "cpu-conditioned-final-v1.2",
  "status": "FROZEN_BEFORE_FINAL_CANDIDATE_TIMING_WITH_EXPLICIT_CORRECTNESS_AND_BATCH_CONTRACT",
  "research_question": "Under a fixed correctness contract and a target-aware compiler, does additional static CPU information help an LLM select a better legal loop optimization for the specified physical CPU?",
  "physical_hosts": {
    "required": 2,
    "hosts": [
      "Intel Haswell-class: Xeon E3-1240 v3",
      "AMD Zen2-class: exact rented CPU recorded at acceptance"
    ],
    "optional_third_host": "Intel Ice Lake/AVX-512-class",
    "comparison_rule": "within-host performance only"
  },
  "dataset": {
    "suite": "PolyBench/C 4.2.1-beta",
    "kernels": "all_30",
    "performance_sizes": [
      "MINI",
      "SMALL",
      "MEDIUM"
    ],
    "performance_initializer": "official_PolyBench_initializer",
    "pilot_six_kernel_results": "development_only_not_main_statistics",
    "main_instance_count": 90,
    "main_candidate_instance_count": 4740,
    "resource_excluded_from_exhaustive_main": [
      "LARGE",
      "EXTRALARGE"
    ],
    "resource_exclusion_reason": "Reference-only preflight exceeded the preregistered resource rule before any candidate timing."
  },
  "compiler_contract": {
    "compiler_family": "Clang/LLVM 18",
    "require_same_version_across_hosts": true,
    "flags": [
      "-O3",
      "-march=native",
      "-fno-fast-math",
      "-ffp-contract=off",
      "-fno-lto"
    ],
    "compiler_knows_target_in_all_P0_P1_P2_conditions": true
  },
  "candidate_space": {
    "policy": "single compiler hint on exactly one syntactic loop",
    "identity": true,
    "hints": {
      "unroll_count": [
        2,
        4,
        8,
        16
      ],
      "interleave_count": [
        2,
        4,
        8
      ],
      "vectorize_width": [
        2,
        4,
        8
      ]
    },
    "candidate_ids_fixed_before_any_final_timing": true,
    "same_candidate_ids_across_hosts": true,
    "no_arbitrary_C_rewrite": true,
    "no_arithmetic_reassociation_request": true,
    "machine_code_hash_each_candidate": true,
    "deduplicate_equal_function_bytes_for_measurement": true,
    "retain_original_candidate_id_for_LLM_scoring": true
  },
  "correctness_gate": {
    "main_30x3_exhaustive_atlas": {
      "scope": {
        "kernels": 30,
        "sizes": [
          "MINI",
          "SMALL",
          "MEDIUM"
        ],
        "instances": 90
      },
      "initializer": "official_PolyBench_initializer",
      "oracle": {
        "profile": "O0_strict_FP",
        "role": "reference_live_out_oracle"
      },
      "candidate_profiles": [
        "generic_O3",
        "native_O3_march_native",
        "ASan_UBSan"
      ],
      "observables": "all_official_PolyBench_live_out_arrays",
      "encoding": "lossless_raw_DATA_TYPE_element_bytes_from_instrumented_PolyBench_print_array",
      "comparison": "exact_byte_equality",
      "readonly_inputs_checked": false,
      "special_FP_stress_inputs": false,
      "negative_control": "per_instance_validator_corruption_control_must_be_rejected",
      "failed_candidate_timed": false
    },
    "six_kernel_stress_supplement": {
      "kernels": [
        "gemm",
        "atax",
        "jacobi-2d",
        "trisolv",
        "nussinov",
        "correlation"
      ],
      "role": "stronger_correctness_evidence_not_main_performance_dataset",
      "full_state_exact_byte_comparison": true,
      "readonly_inputs_checked": true,
      "profiles": [
        "generic_O3",
        "native_O3_march_native",
        "ASan_UBSan"
      ],
      "special_FP_inputs": [
        "full_mantissa_finite_values",
        "cancellation",
        "signed_zero",
        "subnormals"
      ],
      "existing_pilot_evidence_may_be_reused": true
    },
    "formal_equivalence_claim": false,
    "claim_boundary": "The 30-kernel main gate checks every official PolyBench live-out value exactly under the official initializer. The six-kernel supplement additionally checks full state, readonly inputs, and adversarial FP inputs. Neither constitutes universal formal equivalence."
  },
  "measurement": {
    "primary_metric": "paired_batch_throughput",
    "initial_target_batch_ms": 5,
    "sessions": 2,
    "pairs_per_candidate_per_session": 8,
    "quality_thresholds": {
      "relative_iqr": 0.1,
      "identity_log_effect_limit": "log(1.02)",
      "between_session_log_change_limit": "log(1.03)"
    },
    "pre_registered_escalation": {
      "trigger": "identity_control_has_any_quality_warning_for_instance",
      "action": "rerun_entire_instance_all_candidates_once",
      "new_target_batch_ms": 20,
      "second_failure": "invalidate_entire_instance",
      "candidate_specific_failure_with_clean_identity": "mark_candidate_invalid_no_selective_rerun",
      "implementation": {
        "trigger_source": "identity_control_only",
        "second_target_ms": 20,
        "rerun_scope": "entire_instance_all_machine_code_representatives",
        "second_identity_failure": "invalidate_entire_instance"
      }
    },
    "environment": {
      "performance_governor": true,
      "turbo_or_boost": "disabled_and_recorded",
      "SMT": "disabled_for_final_measurement_if_supported",
      "background_package_updates": "stopped_during_measurement",
      "LLM_inference_on_target_host": false
    },
    "implementation_contract": {
      "timer": "CLOCK_MONOTONIC_RAW",
      "batch_definition": "sum_of_kernel_only_durations_over_K_independent_reinitializations_in_one_process",
      "state_reset": "call_original_PolyBench_init_array_before_each_kernel_repetition_outside_timed_region",
      "initial_calibration": {
        "uses": "reference_only",
        "target_ms": 5,
        "repetitions_per_K": 3,
        "K_sequence": "powers_of_two",
        "max_K": 16384
      },
      "warmup": "one_untimed_initialized_kernel_call_per_measurement_process_before_measured_batch",
      "paired_order": "balanced_reference_candidate",
      "schedule_seed": 51054,
      "candidate_observation_timeout_seconds": 60,
      "timeout_policy": "mark_candidate_measurement_invalid_no_selective_rerun",
      "function_boundary": {
        "kernel": "noinline",
        "machine_code_hash": true,
        "deduplicate_equal_function_bytes_per_host_and_instance": true
      }
    }
  },
  "hardware_information_conditions": {
