{
  "protocol_id": "cpu-conditioned-final-v1",
  "status": "FROZEN_BEFORE_FINAL_PHYSICAL_ATLAS",
  "research_question": "Under a fixed correctness contract and a target-aware compiler, does additional static CPU information help an LLM select a better legal loop optimization for the specified physical CPU?",
  "physical_hosts": {
    "required": 2,
    "hosts": [
      "Intel Haswell-class: Xeon E3-1240 v3",
      "AMD Zen2-class: exact rented CPU recorded at acceptance"
    ],
    "optional_third_host": "Intel Ice Lake/AVX-512-class",
    "comparison_rule": "within-host performance only"
  },
  "dataset": {
    "suite": "PolyBench/C 4.2.1-beta",
    "kernels": "all_30",
    "performance_sizes": [
      "MINI",
      "SMALL",
      "MEDIUM",
      "LARGE",
      "EXTRALARGE"
    ],
    "performance_initializer": "official_PolyBench_initializer",
    "pilot_six_kernel_results": "development_only_not_main_statistics"
  },
  "compiler_contract": {
    "compiler_family": "Clang/LLVM 18",
    "require_same_version_across_hosts": true,
    "flags": [
      "-O3",
      "-march=native",
      "-fno-fast-math",
      "-ffp-contract=off",
      "-fno-lto"
    ],
    "compiler_knows_target_in_all_P0_P1_P2_conditions": true
  },
  "candidate_space": {
    "policy": "single compiler hint on exactly one syntactic loop",
    "identity": true,
    "hints": {
      "unroll_count": [
        2,
        4,
        8,
        16
      ],
      "interleave_count": [
        2,
        4,
        8
      ],
      "vectorize_width": [
        2,
        4,
        8
      ]
    },
    "candidate_ids_fixed_before_any_final_timing": true,
    "same_candidate_ids_across_hosts": true,
    "no_arbitrary_C_rewrite": true,
    "no_arithmetic_reassociation_request": true,
    "machine_code_hash_each_candidate": true,
    "deduplicate_equal_function_bytes_for_measurement": true,
    "retain_original_candidate_id_for_LLM_scoring": true
  },
  "correctness_gate": {
    "must_pass_before_timing": true,
    "profiles": [
      "generic_O3",
      "native_O3_march_native",
      "ASan_UBSan"
    ],
    "comparison": "exact_bytes_of_all_observable_buffers",
    "readonly_inputs_checked": true,
    "negative_control_required": true,
    "fp_special_cases": [
      "full_mantissa_finite_values",
      "cancellation",
      "signed_zero",
      "subnormals"
    ],
    "formal_equivalence_claim": false,
    "failed_candidate_timed": false
  },
  "measurement": {
    "primary_metric": "paired_batch_throughput",
    "initial_target_batch_ms": 5,
    "sessions": 2,
    "pairs_per_candidate_per_session": 8,
    "quality_thresholds": {
      "relative_iqr": 0.1,
      "identity_log_effect_limit": "log(1.02)",
      "between_session_log_change_limit": "log(1.03)"
    },
    "pre_registered_escalation": {
      "trigger": "identity_control_has_any_quality_warning_for_instance",
      "action": "rerun_entire_instance_all_candidates_once",
      "new_target_batch_ms": 20,
      "second_failure": "invalidate_entire_instance",
      "candidate_specific_failure_with_clean_identity": "mark_candidate_invalid_no_selective_rerun"
    },
    "environment": {
      "performance_governor": true,
      "turbo_or_boost": "disabled_and_recorded",
      "SMT": "disabled_for_final_measurement_if_supported",
      "background_package_updates": "stopped_during_measurement",
      "LLM_inference_on_target_host": false
    }
  },
  "hardware_information_conditions": {
    "P0": {
      "target_specific_CPU_information": "none"
    },
    "P1": {
      "fields": [
        "CPU_model_name",
        "microarchitecture_name"
      ]
    },
    "P2": {
      "fields": [
        "CPU_model_name",
        "microarchitecture_name",
        "L1D_size",
        "L1I_size",
        "L2_size",
        "L3_size",
        "cache_line_size",
        "supported_relevant_ISA",
        "physical_core_count",
        "hardware_thread_count",
        "SMT_capability",
        "NUMA_topology"
      ],
      "exclude": [
        "measured_candidate_speedups",
        "atlas_rankings",
        "performance_counters",
        "previous_LLM_answers"
      ]
    }
  },
  "llm_evaluation": {
    "models": [
      {
        "family": "Qwen",
        "role": "local_open_baseline",
        "current_model": "qwen2.5-coder:7b-instruct-q4_K_M"
      },
      {
        "family": "GPT",
        "role": "proprietary_strong_model",
        "exact_model_id": "freeze_at_LLM_run_time"
      },
      {
        "family": "Claude",
        "role": "proprietary_strong_model",
        "exact_model_id": "freeze_at_LLM_run_time"
      },
      {
        "family": "Gemini",
        "role": "proprietary_strong_model",
        "exact_model_id": "freeze_at_LLM_run_time"
      }
    ],
    "conditions": [
      "P0",
      "P1",
      "P2"
    ],
    "independent_samples_per_condition": 3,
    "output": "candidate_id_only_structured_JSON",
    "no_performance_feedback_in_main_experiment": true,
    "main_analysis": "within_model_P0_vs_P1_vs_P2"
  },
  "primary_outcomes": [
    "oracle_regret",
    "near_oracle_hit_rate",
    "speedup_over_reference",
    "probability_of_selecting_faster_than_reference",
    "machine_code_noop_selection_rate",
    "CPU_specific_oracle_separability"
  ],
  "secondary_experiment": {
    "name": "feedback_masks_hardware_context",
    "conditions": [
      "P0",
      "P2"
    ],
    "execution": "offline_using_frozen_atlas",
    "requires_new_CPU_measurement": false
  },
  "anti_leakage": {
    "LLM_never_sees_atlas_speedups": true,
    "LLM_never_sees_oracle_rank": true,
    "candidate_space_frozen_before_final_atlas": true,
    "measurement_rules_frozen_before_final_atlas": true
  }
}
